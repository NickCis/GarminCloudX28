project.manifest = manifest.xml

# Monkey Motion lives outside base resources so fr55/enduro3 can omit it.
base.resourcePath = $(base.resourcePath);resources-anim

# fr55: no animation resources (8-color MIP / no Monkey Motion mapping).
fr55.resourcePath = resources;resources-fr55

# enduro/enduro3: no animation resources (no Monkey Motion mapping in SDK).
enduro.resourcePath = resources
enduro3.resourcePath = resources
